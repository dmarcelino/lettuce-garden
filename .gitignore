# Instance data: never commit. See README "What lives where".
/upstream/
/config.env
/.secrets/
/stacks/

# Local git worktrees (git worktree add .worktrees/<branch>)
/.worktrees/

# Build and test output of vault/
__pycache__/
*.egg-info/
.pytest_cache/

# archify delivery receipts (regenerated by `archify finalize`)
docs/diagrams/*.delivery.json
docs/diagrams/*.delivery-pending.json
docs/diagrams/*.browser-check.json
docs/diagrams/*.finalize.json
docs/diagrams/*.finalize-summary.json
