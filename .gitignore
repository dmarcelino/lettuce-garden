# Instance data: never commit. A clone keeps its own in data/ (lib/DESIGN.md);
# the other entries keep an old clone's, or a LETTUCE_DATA pointed inside one,
# out of commits too.
/data/
/upstream/
/config.env
/.secrets/
/stacks/
/stacks.conf

# Written by publish.yml for the lettucectl image; in a clone it would switch
# lettucectl to release mode.
/RELEASE

# Local git worktrees (git worktree add .worktrees/<branch>)
/.worktrees/

# Build and test output of vault/
__pycache__/
*.egg-info/
.pytest_cache/

# archify delivery receipts (regenerated by `archify finalize`)
docs/diagrams/*.delivery.json
docs/diagrams/*.delivery-pending.json
docs/diagrams/*.browser-check.json
docs/diagrams/*.finalize.json
docs/diagrams/*.finalize-summary.json
