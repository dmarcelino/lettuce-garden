# How the editor's terminals reach the shell (garden-code-server-exec). The
# only host; key login with the editor's own key; the host key is pinned (the
# entrypoint writes known_hosts). Nothing is forwarded and no environment is sent.
Host garden-code-server-exec
  HostName garden-code-server-exec
  Port 22
  User root
  IdentityFile /data/ssh/id_ed25519
  IdentitiesOnly yes
  UserKnownHostsFile /data/ssh/known_hosts
  GlobalKnownHostsFile /dev/null
  StrictHostKeyChecking yes
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  ForwardAgent no
  ForwardX11 no
  ClearAllForwardings yes
  ControlMaster auto
  ControlPath /tmp/ssh-%C
  ControlPersist 10m
  ServerAliveInterval 30
  LogLevel ERROR

