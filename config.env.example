# lettucectl configuration. Copy to config.env (chmod 600) and edit.
# Plain KEY=value lines: no quotes, no spaces around '=', no inline comments.

# Cloudflare zone the stacks are published under. Each stack gets
# <name>.<DOMAIN>, or HOSTNAME_FALLBACK when that name already exists in DNS,
# and <name>-garden.<DOMAIN> (or HOSTNAME_FALLBACK followed by -garden) for its
# garden pages.
DOMAIN=example.com
HOSTNAME_FALLBACK=lettuce-%s

# Upstream Lettuce, on GitHub. lettucectl downloads its source at this tag into
# upstream/<tag>/. The tag pins the letta-code version the UI is compiled
# against; change it only with `lettucectl upgrade <tag>`. A release starts on
# the tag it was tested with, and `self-upgrade` moves it forward.
LETTUCE_REPO=https://github.com/dmarchevsky/lettuce.git
LETTUCE_REF=v0.42.3-letta_0.34.38

# Compose profiles for EVERY stack. Must contain `cloudflared`. All stacks share
# one app-server image whose contents depend on this list (codex, claude), so it
# is global on purpose. See upstream docs/CONFIGURATION.md for the options;
# `garden-vault` (this repo's personal vault, docs/vault.md),
# `garden-gmail-triggers` (docs/gmail-triggers.md), `garden-code-server`
# (docs/code-server.md), `garden-watchlist` (sources agents set up, reported on a
# schedule, docs/watchlist.md), `garden-pipelock` (an advisory egress proxy with
# signed receipts, docs/egress-firewall.md) and `garden-doc-tools` (Office and PDF
# tools, docs/doc-tools.md) are this repo's own.
# Once stacks exist, change it with `lettucectl profiles <list>`, which updates
# every stack.env too.
PROFILES=cloudflared,search

# With garden-pipelock: hosts the app-server reaches without pipelock, which
# refuses private addresses, such as a model server on the LAN. Comma-separated
# host names or IP addresses, each with an optional port, or .domain suffixes.
# A stack.env PIPELOCK_DIRECT adds hosts for that stack (docs/egress-firewall.md).
PIPELOCK_DIRECT=
# IANA timezone for all containers; agent schedules fire in this zone.
TZ=UTC

# Operator address for push notifications (the VAPID `sub` claim) in every
# stack; push services use it to contact whoever runs the server. Required.
PUSH_CONTACT_EMAIL=

# How long a Cloudflare Access sign-in lasts before Google is asked again.
ACCESS_SESSION_DURATION=24h
# Watchlist (garden-watchlist profile, docs/watchlist.md); empty keeps the default
# shown. `up` copies them into every stack.
# When a monitor reports if the person names no schedule, every day, in TZ.
WATCHLIST_DEFAULT_TIMES=08:00,14:00,20:00
# Reports one agent may get per day, all its monitors together (1 to 48).
WATCHLIST_MAX_REPORTS_PER_DAY=6
# The shortest interval between two fetches of one source (5m to 7d).
WATCHLIST_MIN_INTERVAL=1h
# Sources and monitors per stack.
WATCHLIST_MAX_SOURCES=100
WATCHLIST_MAX_MONITORS=50

# Filled in by `lettucectl init`; leave empty. LETTA_IMAGE_NS is where Lettuce's
# images are pulled from, empty when none are published for this host (they are
# built here); `init` and `upgrade` look it up.
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_TEAM_DOMAIN=
CF_GOOGLE_IDP_ID=
LETTA_IMAGE_NS=
