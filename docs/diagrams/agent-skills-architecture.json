  "cards": [
    {
      "dot": "emerald",
      "title": "What skills replaces",
      "items": [
        "Only directories with a SKILL.md are shipped, with lowercase names; a name upstream Lettuce also ships is refused, since the BFF would overwrite it",
        "The tar is unpacked into a dot directory first, so a broken stream changes nothing; then the skills the manifest lists are removed, the new ones moved in, and the manifest rewritten",
        "Upstream's skills and those enabled in Settings stay; up does not install skills, and backup leaves ours out"
      ]
    },
    {
      "dot": "amber",
      "title": "Instructions, not boundaries",
      "items": [
        "Skills tell agents what to do; agents are root in the app-server and can ignore them",
        "Skill text lands in every operator's stacks: keep it generic"
      ]
    },
    {
      "dot": "slate",
      "title": "Each skill applies only with its feature",
      "items": [
        "using-vault-secrets: the vault MCP server (garden-vault profile)",
        "working-with-documents: office and pdf in Settings -> MCP (garden-doc-tools)",
        "fetching-web-pages: HTTPS_PROXY pointing at garden-pipelock (garden-pipelock)"
      ]
    }
  ]
