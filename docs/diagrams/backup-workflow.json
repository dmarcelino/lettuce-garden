  "cards": [
    {
      "dot": "rose",
      "title": "Container limits",
      "items": [
        "--init, --network none, --read-only, --tmpfs /tmp, no-new-privileges",
        "cap_drop ALL, then CHOWN, DAC_OVERRIDE and FOWNER only",
        "state, stack.env, vault-data, pipelock-data and watchlist-data (when the volume exists) read-only; only <dir>/<name> is writable",
        "Old .partial-* entries and pruned snapshots are deleted through the same container"
      ]
    },
    {
      "dot": "cyan",
      "title": "--compress",
      "items": [
        "tar.gz to stdout into .partial-<TS>.tar.gz, renamed when complete",
        "no --link-dest: each archive holds everything"
      ]
    },
    {
      "dot": "violet",
      "title": "Same image, other use",
      "items": [
        "ensure_doc_tools_volume fills the doc-tools volume through this image"
