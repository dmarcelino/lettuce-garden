  "cards": [
    {
      "dot": "cyan",
      "title": "Compose files, in order",
      "items": [
        "upstream/docker/compose.yml, then hardening, multi, vault, gmail-triggers, pipelock, code-server, garden",
        "doc-tools.yml only with garden-doc-tools, pipelock-proxy.yml last and only with garden-pipelock",
        "-p lettuce-<name>, --project-directory upstream/docker, --env-file stack.env"
      ]
    },
    {
      "dot": "rose",
      "title": "Gates",
      "items": [
        "check_stack renders the merged config and dies on the first unsafe setting",
        "env -i: the caller's shell cannot override stack.env",
        "check_gotenberg runs before the shared Gotenberg starts"
      ]
    },
    {
      "dot": "amber",
      "title": "Failures after compose up",
      "items": [
        "executor, MCP and doc-tools failures are collected per stack",
        "up fails at the end; running it again repairs the state"
      ]
    }
