  "cards": [
    {
      "dot": "rose",
      "title": "What pipelock checks",
      "items": [
        "Destination of every proxied request: paste and file-drop blocklist, private and cloud-metadata addresses, data hidden in host names, 600 requests per minute per site",
        "Page text and full URL only for pages read through /fetch (the fetching-web-pages skill)",
        "Every allow and block is a hash-chained receipt signed with the stack's own Ed25519 key"
      ]
    },
    {
      "dot": "amber",
      "title": "What it does not do",
      "items": [
        "Advisory, not a boundary: the stack network still reaches the internet, and any agent can unset HTTPS_PROXY",
        "No TLS interception: for HTTPS it sees the host name, not paths, bodies or responses",
        "letta-code, the BFF, the vault, google-mcp and gmail-triggers connect directly"
      ]
    },
    {
      "dot": "slate",
      "title": "Guarded by lettucectl check",
      "items": [
        "pipelock hardened: read-only, no capabilities, no host mounts",
        "Only pipelock mounts pipelock-data, whatever the profiles",
        "The app-server's proxy points at pipelock, and NO_PROXY keeps the vault and the executor's token away from it"
      ]
    }
  ]
