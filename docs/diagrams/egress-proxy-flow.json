  "cards": [
    {
      "dot": "emerald",
      "title": "What it checks",
      "items": [
        "A blocklist of paste and file-drop sites, private and cloud-metadata addresses, data hidden in host names, runaway request rates",
        "Pages read through /fetch: the whole URL for secrets, the text for prompt injection (blocked)"
      ]
    },
    {
      "dot": "rose",
      "title": "What it does not do",
      "items": [
        "It is not a boundary: the stack still reaches the internet directly, and any agent can unset HTTPS_PROXY",
        "No content checks on HTTPS: only the host name is seen, except through /fetch",
        "Receipts show what this pipelock decided, not that nothing went around it"
      ]
    }
  ]
