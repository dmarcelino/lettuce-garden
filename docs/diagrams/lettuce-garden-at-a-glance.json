  "cards": [
    {
      "dot": "emerald",
      "title": "One stack per person",
      "items": [
        "Each person gets their own agents, memory, workspaces and secrets",
        "Lettuce at <name>.<domain>; the garden pages at <name>-garden.<domain>",
        "Nobody can reach another person's stack"
      ]
    },
    {
      "dot": "rose",
      "title": "Cloudflare authenticates the people",
      "items": [
        "Two Access applications per stack, Lettuce's and the garden's, sharing one policy: only that stack's people, with Google sign-in",
        "The garden pages accept only the garden's sign-in, never Lettuce's",
        "Lettuce checks the token is for its own stack, and the email against its list; lettucectl users changes both together"
      ]
    },
    {
      "dot": "cyan",
      "title": "Docker separates the assistants",
      "items": [
        "Each stack is its own Compose project, lettuce-<name>",
        "No ports published on the host: each tunnel connects outbound",
        "Garden pages: vault, Gmail triggers, News Radar, code editor (those turned on)"
      ]
    }
  ]
