  "cards": [
    {
      "dot": "cyan",
      "title": "add creates, in order",
      "items": [
        "Access policy, Access app, garden Access app, tunnel, tunnel token, tunnel ingress, garden DNS, DNS",
        "each id goes into stack.env as soon as it exists; CF_DNS_RECORD_ID last means complete"
      ]
    },
    {
      "dot": "rose",
      "title": "remove deletes in reverse",
      "items": [
        "DNS, garden DNS, tunnel (with its token), garden app, Lettuce app, policy",
        "each id is unset only when its DELETE succeeds, so remove can be retried"
      ]
    },
    {
      "dot": "amber",
      "title": "Never",
      "items": [
        "source config.env or stack.env",
        "put the Cloudflare API token in argv",
        "call docker compose outside the compose wrappers"
      ]
    }
  ]
