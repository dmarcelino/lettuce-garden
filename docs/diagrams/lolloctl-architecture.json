  "cards": [
    {
      "dot": "cyan",
      "title": "Release install or clone",
      "items": [
        "release: the wrapper runs the lolloctl image with the data directory and the Docker socket at the same path; RELEASE in the image names every published image",
        "clone: ./lolloctl on the host, data in the clone's data/, every image built here"
      ]
    },
    {
      "dot": "cyan",
      "title": "add creates, in order",
      "items": [
        "its stacks.conf line first, so apply resumes an add that stopped",
        "Access policy, Access app, lollo Access app, tunnel, tunnel token, tunnel ingress, lollo DNS, DNS; each id goes into stack.env as soon as it exists"
      ]
    },
    {
      "dot": "rose",
      "title": "remove deletes in reverse",
      "items": [
        "DNS, lollo DNS, tunnel (with its token), lollo app, Lettuce app, policy",
        "each id is unset only when its DELETE succeeds, so remove can be retried"
      ]
    },
    {
      "dot": "amber",
      "title": "Never",
      "items": [
        "source config.env, stack.env or stacks.conf",
        "put the Cloudflare API token in argv",
        "hand Docker a host path not mounted at the same path"
      ]
    }
  ]
