  "cards": [
    {
      "dot": "emerald",
      "title": "You decide",
      "items": [
        "Mail: off, readonly, organize, drafts, send or full",
        "Calendar: off, readonly, self-events (your own time, no invitations) or full",
        "Tasks: off, readonly or manage",
        "Sends and invitations only to your allowed recipients; shared mailboxes read-only"
      ]
    },
    {
      "dot": "rose",
      "title": "What it does not stop",
      "items": [
        "It limits who the account mails or invites, not what an agent reads within its level",
        "Mail, event and task text can still mislead an agent",
        "Reusing the browser's sign-in is not a supported Microsoft route: your tenant can refuse it"
      ]
    },
    {
      "dot": "slate",
      "title": "Where things live",
      "items": [
        "The token stays sealed in the Outlook service's own volume",
        "Not in lettucectl backup: after a restore you connect again",
        "Disconnect on the page, or the admin turns the profile off"
      ]
    }
  ]
