  "cards": [
    {
      "dot": "cyan",
      "title": "Named by content",
      "items": [
        "a garden image's tag hashes its build context, its shared context, its name and REBUILD",
        "an unchanged image keeps its name and digest, so its container is not recreated and a vault stays unlocked"
      ]
    },
    {
      "dot": "amber",
      "title": "Built on the admin's host, never published",
      "items": [
        "doc-tools (AGPL-3.0 PyMuPDF) and the code editor's shell (FROM the app-server's image)",
        "both build contexts ship inside the lettucectl image"
      ]
    },
    {
      "dot": "rose",
      "title": "Nothing moves after a release",
      "items": [
        "no latest and nothing from main: the wrapper names the lettucectl image by digest",
        "the notes list the images that changed, so which containers restart and whether vaults lock"
      ]
    }
  ]
