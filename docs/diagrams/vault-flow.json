  "cards": [
    {
      "dot": "emerald",
      "title": "You decide",
      "items": [
        "Logins, cards, SSH keys, custom fields and ID numbers always ask",
        "A note's text and an identity's address ask unless you allow them",
        "Agents can't add, change or delete secrets"
      ]
    },
    {
      "dot": "rose",
      "title": "What it does not stop",
      "items": [
        "Values shared as text are in the conversation: your AI provider sees them and the server stores them",
        "Placeholders are a precaution: a misled agent can redeem a handle itself or open the filled file",
        "The rules are instructions to the agent, not something the vault can enforce"
      ]
    },
    {
      "dot": "slate",
      "title": "Limits",
      "items": [
        "At most 5 requests wait at once; each expires after 10 minutes",
        "A handle works once, within 5 minutes; at most 10 unused",
        "Locking the vault cancels every handle and uncollected value"
      ]
    }
  ]
