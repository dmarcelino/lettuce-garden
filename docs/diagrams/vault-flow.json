  "cards": [
    {
      "dot": "emerald",
      "title": "You decide",
      "items": [
        "ID documents, payment cards and logins always ask",
        "Notes, addresses, companies and memberships ask unless you allow that secret to be used without asking",
        "Agents can't add, change or delete secrets"
      ]
    },
    {
      "dot": "rose",
      "title": "What it does not stop",
      "items": [
        "A value shared as text is in the conversation: your AI provider sees it and the server stores it",
        "The rules are instructions to the agent, not something the vault can enforce",
        "vault-run keeps values out of the conversation, but a misled agent can still redeem the handle itself"
      ]
    },
    {
      "dot": "slate",
      "title": "Limits",
      "items": [
        "At most 5 requests wait at once; each expires after 10 minutes",
        "Locking the vault cancels every handle and uncollected value"
      ]
    }
  ]
