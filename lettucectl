#!/usr/bin/env bash
# lettucectl: run several Lettuce stacks on one host, one per person, each behind
# its own Cloudflare Tunnel and Cloudflare Access application (Google login).
# See README.md and docs/.
set -euo pipefail

LETTUCE_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source=lib/common.sh
. "$LETTUCE_HOME/lib/common.sh"
# shellcheck source=lib/cloudflare.sh
. "$LETTUCE_HOME/lib/cloudflare.sh"

MIN_COMPOSE=2.24.0

usage() {
  cat <<'EOF'
Usage: lettucectl <command> [args]

Setup
  init                          check dependencies, clone upstream Lettuce, look up Cloudflare ids
  add <name> <email>[,<email>]  create a stack: hostname, Access policy + app, tunnel, DNS; start it
  users <name> <email>[,...]    replace who may sign in (Access policy and ALLOWED_USERS together)
  remove <name> [--purge]       stop a stack and delete its Cloudflare resources (--purge: its data too)
  profiles [<p>,<p>...]         show, or set for every stack, the compose profiles (optional features)
  upgrade <tag>                 move upstream Lettuce to another tag and rebuild every stack

Operation (<target> is a stack name or "all")
  up <target>                   check, then build and start
  down <target>                 stop
  restart <target>              down + up (app-server and bff share a namespace; never restart one alone)
  check <target>                refuse unsafe or inconsistent configuration
  skills <target>               install agent-skills/ into running stacks (every agent of the stack)
  backup <target> <dir> [opts]  copy agents, memory, workspaces, tools, vault and receipts to a snapshot in <dir>/<name>/
                                (--compress: a tar.gz instead; --no-tools; --pause|--live; --keep N)
  status                        containers and health of every stack
  list                          stacks, hostnames and allowed users
  logs <name> [service]         follow logs
  compose <name> <args...>      any other docker compose command for one stack
  shell <name> [agent]          bash in the app-server, in /work or in an agent's workspace (name or id)
  toolbox <name> <agent> [cmd]  bash (or cmd) in an agent's workspace with your own ssh, git, gh and Claude Code
                                (--tools before <name>: the agents' installed tools, read-only; --tools=rw: writable)
  receipts <name> [<file.html>] verify pipelock's signed receipts and list its sessions, or write one session's
           [<session>]          report (default: the newest) to <file.html>
EOF
}

# ── helpers ──────────────────────────────────────────────────────────────────
version_ge() { printf '%s\n%s\n' "$2" "$1" | sort -V -C; }

# pick_hostname NAME -> <name>.<domain>, or the fallback when that name exists in DNS
pick_hostname() {
  local name=$1 domain zone probe wildcard="" host rc fallback
  domain=$(cfg DOMAIN)
  zone=$(cfg CF_ZONE_ID)
  probe="lettucectl-probe-$(openssl rand -hex 4).$domain"
  if [[ -n $(dig +short A "$probe") ]]; then
    wildcard=1
    warn "$domain has a wildcard DNS record, so public DNS cannot tell which names are taken; checking the Cloudflare zone only"
  fi
  fallback=$(cfg HOSTNAME_FALLBACK)
  [[ $fallback == *%s* ]] || die "HOSTNAME_FALLBACK must contain %s"
  # shellcheck disable=SC2059 # the pattern is the format string by design
  for host in "$name.$domain" "$(printf "$fallback" "$name").$domain"; do
    if [[ -z $wildcard ]] && name_resolves "$host"; then
      info "$host already exists in DNS"
      continue
    fi
    rc=0
    cf_dns_name_taken "$zone" "$host" || rc=$?
    case $rc in
      0) info "$host already exists in the Cloudflare zone" ;;
      1)
        printf '%s' "$host"
        return 0
        ;;
      *) die "could not check $host in the Cloudflare zone" ;;
    esac
  done
  die "both $name.$domain and $host are taken; choose another stack name"
}

name_resolves() {
  local t
  for t in A AAAA CNAME TXT MX; do
    [[ -n $(dig +short "$t" "$1") ]] && return 0
  done
  return 1
}

write_new_stack_env() {
  local name=$1 host=$2 emails=$3 f
  f=$(stack_env "$name")
  (umask 077 && mkdir -p "$(stack_dir "$name")/state")
  chmod 700 "$(stack_dir "$name")"
  (
    umask 077
    cat >"$f" <<EOF
# Lettuce stack "$name", managed by lettucectl. Read by Docker Compose.
# Secrets: keep this file mode 600 and out of version control.
LETTUCE_HOSTNAME=$host
PUBLIC_ORIGIN=https://$host
ALLOWED_USERS=$emails
COMPOSE_PROFILES=$(cfg PROFILES)
LETTA_STATE_DIR=$(stack_dir "$name")/state
TZ=$(cfg TZ)
SESSION_SECRET=$(openssl rand -hex 32)
CF_ACCESS_TEAM_DOMAIN=$(cfg CF_TEAM_DOMAIN)
EOF
  )
}

# google_reminder NAME -> the step only the operator can do: Google has no API
# for an OAuth client's redirect URIs.
google_reminder() {
  info "Google: add $(google_redirect_uri "$1") to your Google OAuth client's redirect URIs,"
  info "  then connect in that stack's Settings -> Google (docs/google-setup.md)"
}

# route_stack NAME -> re-applies the stack's tunnel routes for its current
# profiles; a stack whose setup never got a tunnel is skipped
route_stack() {
  local f tun
  f=$(stack_env "$1")
  tun=$(env_get "$f" CF_TUNNEL_ID)
  [[ -n $tun && -n $(env_get "$f" CF_DNS_RECORD_ID) ]] || return 0
  cf_tunnel_configure "$(cfg CF_ACCOUNT_ID)" "$tun" "$(env_get "$f" LETTUCE_HOSTNAME)" "$(env_get "$f" COMPOSE_PROFILES)"
}

# Run by sh in the app-server as: sh -c "$SKILLS_INSTALL" sh DIR SKILL... with a tar
# of the skills on stdin. Replaces what the last run installed (the manifest) and
# leaves every other skill in DIR alone. Extracting into a dot directory first
# means a broken stream changes nothing; skill discovery ignores dot directories.
# shellcheck disable=SC2016 # expanded by sh in the container
SKILLS_INSTALL='set -e
d=$1
shift
mkdir -p "$d"
t=$(mktemp -d "$d/.lettucectl.XXXXXX")
trap '\''rm -rf "$t"'\'' EXIT
tar -C "$t" --no-same-owner -xf -
if [ -f "$d/.lettucectl-skills" ]; then
  while read -r s; do [ -n "$s" ] && rm -rf "${d:?}/$s"; done <"$d/.lettucectl-skills"
fi
for s in "$@"; do
  rm -rf "${d:?}/$s"
  mv "$t/$s" "$d/$s"
done
printf "%s\n" "$@" >"$d/.lettucectl-skills"'

# sync_skills NAME -> installs agent-skills/ into the stack's global skills, which
# every agent of the stack loads; prints how many
sync_skills() {
  local src=$LETTUCE_HOME/agent-skills f s skills=()
  for f in "$src"/*/SKILL.md; do
    [[ -f $f ]] || continue
    s=${f%/SKILL.md}
    s=${s##*/}
    [[ $s =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid skill name '$s': lowercase letters, digits and '-'"
    # The BFF rewrites its own skills on every connect, over any of ours.
    [[ ! -e $(upstream_dir)/docker/agent-skills/$s ]] || die "skill '$s' is also shipped by upstream Lettuce; rename it"
    skills+=("$s")
  done
  if ((${#skills[@]})); then
    tar -C "$src" -cf - "${skills[@]}"
  else
    tar -cf - -T /dev/null
  fi | compose "$1" exec -T app-server sh -c "$SKILLS_INSTALL" sh /root/.letta/skills "${skills[@]}" ||
    die "$1: could not install skills (is the stack up?)"
  printf '%s' "${#skills[@]}"
}

# The gmail-triggers executor (gmail-triggers/executor/run.mjs): the app-server's
# cron runs it every minute, through upstream's agent-env (PID 1's environment),
# to fetch the sidecar's queued requests over /executor/v1/ and turn each into
# `letta cron add --once`. It lives in a namespace we own under letta-home, so a
# restart keeps it; the cron file goes to system-cron, which the entrypoint
# copies to /etc/cron.d at every start. Its token stays in the container layer,
# out of the state directory and its backups; every recreate goes through `up`,
# which installs it again. Agents can read the token: it keeps the stack's other
# containers out, not them.
GT_DIR=/root/.letta/garden/gmail-triggers
GT_JOB=lettuce-garden-gmail-triggers
GT_TOKEN=/etc/lettuce-garden/gmail-triggers-token
GT_CRON="# Installed by lettucectl (gmail-triggers profile). Removed with the profile.
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=\"\"
* * * * * root /usr/local/bin/agent-env node $GT_DIR/bin/run.mjs >> $GT_DIR/executor.log 2>&1"

# Run by sh in the app-server as
#   sh -c "$GARDEN_INSTALL" sh install DIR JOB CRONDIR ETCDIR TOKEN CRON  (a tar of run.mjs and token on stdin)
#   sh -c "$GARDEN_INSTALL" sh uninstall DIR JOB CRONDIR ETCDIR TOKEN
# install replaces DIR/bin/run.mjs, the token file TOKEN (0600, its directory
# 0700) and the cron text CRON in CRONDIR/JOB and ETCDIR/JOB (which starts it
# now), each by a rename from a dot file next to it. The token comes on stdin,
# never in argv. Nothing changes unless the stream holds both files.
# uninstall removes both cron files, the token (and its directory once empty)
# and DIR/bin.
# shellcheck disable=SC2016 # expanded by sh in the container
GARDEN_INSTALL='set -e
mode=$1 d=$2 job=$3 sys=$4 etc=$5 tok=$6
if [ "$mode" = uninstall ]; then
  rm -f "$etc/$job" "$sys/$job" "$tok"
  rmdir "${tok%/*}" 2>/dev/null || :
  rm -rf "${d:?}/bin"
  exit 0
fi
cron=$7
t=$(mktemp -d)
trap '\''rm -rf "$t"'\'' EXIT
tar -C "$t" --no-same-owner -xf -
for f in run.mjs token; do
  [ -f "$t/$f" ] || { echo "$f is missing from the stream" >&2; exit 1; }
done
printf "%s\n" "$cron" >"$t/cron"
put() { install -m "$2" "$1" "${3%/*}/.${3##*/}.new" && mv -f "${3%/*}/.${3##*/}.new" "$3"; }
mkdir -p "$d/bin" "$sys" "$etc" "${tok%/*}"
chmod 700 "${tok%/*}"
put "$t/run.mjs" 0644 "$d/bin/run.mjs"
put "$t/token" 0600 "$tok"
put "$t/cron" 0644 "$sys/$job"
put "$t/cron" 0644 "$etc/$job"'

# executor_installed NAME -> success when the stack's letta-home holds the
# executor or its cron file (seen from the host, so stacks that never had it
# cost no exec)
executor_installed() {
  local h
  h=$(env_get "$(stack_env "$1")" LETTA_STATE_DIR)/letta-home
  [[ -e $h/garden/gmail-triggers/bin || -e $h/system-cron/$GT_JOB ]]
}

# install_executor NAME -> streams the executor and the stack's executor token
# into the running app-server. The token file is built in a private temp dir
# and travels inside the tar.
install_executor() {
  local src=$LETTUCE_HOME/gmail-triggers/executor tmp rc=0
  [[ -f $src/run.mjs ]] || {
    warn "$src/run.mjs is missing"
    return 1
  }
  tmp=$(mktemp -d) || return 1
  cp "$src/run.mjs" "$tmp/run.mjs" &&
    (umask 077 && printf '%s\n' "$(env_get "$(stack_env "$1")" GMAIL_TRIGGERS_EXECUTOR_TOKEN)" >"$tmp/token") || rc=1
  if ((rc == 0)); then
    tar -C "$tmp" -cf - run.mjs token |
      compose "$1" exec -T app-server sh -c "$GARDEN_INSTALL" sh install "$GT_DIR" "$GT_JOB" \
        /root/.letta/system-cron /etc/cron.d "$GT_TOKEN" "$GT_CRON" || rc=1
  fi
  rm -rf "$tmp"
  return "$rc"
}

# uninstall_executor NAME -> removes the executor, its token and its cron file
uninstall_executor() {
  compose "$1" exec -T app-server sh -c "$GARDEN_INSTALL" sh uninstall "$GT_DIR" "$GT_JOB" \
    /root/.letta/system-cron /etc/cron.d "$GT_TOKEN" </dev/null || return 1
  info "$1: removed the gmail-triggers executor (its profile is off)"
}

# sync_executor NAME -> the running stack has the executor exactly when it has
# the gmail-triggers profile; warns and fails when it cannot make it so
sync_executor() {
  if has_profile "$(env_get "$(stack_env "$1")" COMPOSE_PROFILES)" gmail-triggers; then
    install_executor "$1" && return 0
    warn "$1: could not install the gmail-triggers executor; the stack is up but its Gmail triggers will not run"
    return 1
  elif executor_installed "$1"; then
    uninstall_executor "$1" && return 0
    warn "$1: could not remove the gmail-triggers executor, so it may still run"
    return 1
  fi
}

# executor_out_of_step NAME... -> fails, naming the stacks whose executor could
# not be synced; `up` syncs it again, whatever command stopped
executor_out_of_step() {
  die "the gmail-triggers executor is out of step on: $*; fix the cause, then run: lettucectl up <name>"
}

# up_stack NAME -> checks one stack, then builds and starts it
up_stack() {
  ensure_push_keys "$1"
  ensure_executor_token "$1"
  sync_garden_profiles "$1"
  check_stack "$1"
  info "starting $1"
  compose "$1" up -d --build --remove-orphans
}

# ── commands ─────────────────────────────────────────────────────────────────
cmd_init() {
  local c v f ref cur zone team idp
  for c in docker git curl jq openssl dig; do
    command -v "$c" >/dev/null || die "$c is required but not installed"
  done
  v=$(docker compose version --short 2>/dev/null) || die "the Docker Compose plugin is required"
  version_ge "${v#v}" "$MIN_COMPOSE" || die "Docker Compose >= 2.24 is required (found $v)"

  f=$(config_file)
  if [[ ! -f $f ]]; then
    (umask 077 && cp "$LETTUCE_HOME/config.env.example" "$f")
    chmod 600 "$f"
    die "created config.env; edit DOMAIN, PROFILES and TZ, then run: lettucectl init"
  fi
  require_config

  f=$(token_file)
  [[ -f $f ]] || die "no Cloudflare API token at .secrets/cloudflare-api-token (docs/cloudflare-setup.md, step 5)"
  [[ $(file_mode "$f") == 600 ]] || die "the API token file must be mode 600 (chmod 600 $f)"

  ref=$(cfg LETTUCE_REF)
  if [[ ! -e $(upstream_dir) ]]; then
    info "cloning $(cfg LETTUCE_REPO) at $ref"
    git -c advice.detachedHead=false clone -q --branch "$ref" "$(cfg LETTUCE_REPO)" "$(upstream_dir)"
  elif [[ -d $(upstream_dir)/.git ]]; then
    cur=$(git -C "$(upstream_dir)" describe --tags --exact-match 2>/dev/null || echo "an untagged commit")
    [[ $cur == "$ref" ]] || warn "upstream/ is at $cur but config.env says $ref; run: lettucectl upgrade $ref"
  fi
  [[ -f $(upstream_dir)/docker/compose.yml ]] || die "upstream/docker/compose.yml not found"

  zone=$(cf_zone "$(cfg DOMAIN)") || die "could not look up the zone (is the API token valid?)"
  [[ -n $zone ]] || die "zone $(cfg DOMAIN) not found: is the domain added to Cloudflare, and does the token have Zone Read on it?"
  team=$(cf_team "${zone#* }") || die "could not read the Zero Trust organization (token needs Access: Organizations, Identity Providers, and Groups Read)"
  [[ -n $team ]] || die "no Zero Trust organization yet (docs/cloudflare-setup.md, step 3)"
  idp=$(cf_google_idp "${zone#* }") || die "could not list Access login methods"
  [[ -n $idp ]] || die "no Google login method in Zero Trust (docs/cloudflare-setup.md, step 4)"

  f=$(config_file)
  env_set "$f" CF_ZONE_ID "${zone%% *}"
  env_set "$f" CF_ACCOUNT_ID "${zone#* }"
  env_set "$f" CF_TEAM_DOMAIN "$team"
  env_set "$f" CF_GOOGLE_IDP_ID "$idp"
  info "ready: zone $(cfg DOMAIN), Access team $team.cloudflareaccess.com, upstream $ref"
  info "next: lettucectl add <name> <email>"
}

cmd_add() {
  (($# == 2)) || die "usage: lettucectl add <name> <email>[,<email>]"
  local name=$1 emails f host acc id pair synced=1
  validate_name "$name"
  emails=$(normalise_emails "$2")
  require_initialised
  f=$(stack_env "$name")
  acc=$(cfg CF_ACCOUNT_ID)

  if [[ -n $(env_get "$f" CF_DNS_RECORD_ID) ]]; then
    die "stack '$name' already exists (use: lettucectl users|up|remove $name)"
  elif [[ -f $f ]]; then
    host=$(env_get "$f" LETTUCE_HOSTNAME)
    info "resuming the unfinished setup of '$name' ($host)"
    [[ -n $(env_get "$f" CF_ACCESS_POLICY_ID) ]] || env_set "$f" ALLOWED_USERS "$emails"
  else
    host=$(pick_hostname "$name")
    write_new_stack_env "$name" "$host" "$emails"
  fi
  emails=$(env_get "$f" ALLOWED_USERS)
  local hint="Cloudflare setup of '$name' stopped part-way; what exists is recorded in stacks/$name/stack.env. Fix the cause, then re-run: lettucectl add $name $emails"

  if [[ -z $(env_get "$f" CF_ACCESS_POLICY_ID) ]]; then
    id=$(cf_policy_create "$acc" "lettuce-$name" "$emails") || die "$hint"
    env_set "$f" CF_ACCESS_POLICY_ID "$id"
  fi
  if [[ -z $(env_get "$f" CF_ACCESS_APP_ID) ]]; then
    pair=$(cf_app_create "$acc" "lettuce-$name" "$host" "$(cfg CF_GOOGLE_IDP_ID)" \
      "$(cfg ACCESS_SESSION_DURATION)" "$(env_get "$f" CF_ACCESS_POLICY_ID)") || die "$hint"
    env_set "$f" CF_ACCESS_APP_ID "${pair%% *}"
    env_set "$f" CF_ACCESS_AUD "${pair#* }"
  fi
  if [[ -z $(env_get "$f" CF_TUNNEL_ID) ]]; then
    id=$(cf_tunnel_create "$acc" "lettuce-$name") || die "$hint"
    env_set "$f" CF_TUNNEL_ID "$id"
  fi
  if [[ -z $(env_get "$f" CLOUDFLARE_TUNNEL_TOKEN) ]]; then
    id=$(cf_tunnel_token "$acc" "$(env_get "$f" CF_TUNNEL_ID)") || die "$hint"
    env_set "$f" CLOUDFLARE_TUNNEL_TOKEN "$id"
  fi
  cf_tunnel_configure "$acc" "$(env_get "$f" CF_TUNNEL_ID)" "$host" "$(env_get "$f" COMPOSE_PROFILES)" || die "$hint"
  id=$(cf_dns_cname_create "$(cfg CF_ZONE_ID)" "$host" "$(env_get "$f" CF_TUNNEL_ID)" "lettucectl stack $name") || die "$hint"
  env_set "$f" CF_DNS_RECORD_ID "$id"

  # Not cmd_up: the stack is complete now, so `add` can't be re-run, and a
  # failed executor install must not hide the Google step.
  up_stack "$name"
  sync_executor "$name" || synced=0
  info ""
  info "'$name' is up: https://$host (sign in with Google as $emails)"
  info "First boot builds images and can take a few minutes; the hostname may need a minute to resolve."
  if has_profile "$(cfg PROFILES)" google; then
    google_reminder "$name"
  fi
  ((synced)) || executor_out_of_step "$name"
}

cmd_users() {
  (($# == 2)) || die "usage: lettucectl users <name> <email>[,<email>]"
  local name=$1 emails f pol
  validate_name "$name"
  emails=$(normalise_emails "$2")
  require_initialised
  require_stack "$name"
  f=$(stack_env "$name")
  pol=$(env_get "$f" CF_ACCESS_POLICY_ID)
  [[ -n $pol ]] || die "'$name' has no Access policy yet; finish it with: lettucectl add $name $emails"
  cf_policy_update "$(cfg CF_ACCOUNT_ID)" "$pol" "lettuce-$name" "$emails" || die "could not update the Access policy"
  env_set "$f" ALLOWED_USERS "$emails"
  cmd_up "$name"
  info "'$name' now admits: $emails"
}

cmd_remove() {
  local name=${1:-} purge="" answer f acc zone id state
  [[ ${2:-} == --purge ]] && purge=1
  [[ -n $name && ($# == 1 || -n $purge) ]] || die "usage: lettucectl remove <name> [--purge]"
  validate_name "$name"
  require_initialised
  require_stack "$name"
  f=$(stack_env "$name")
  acc=$(cfg CF_ACCOUNT_ID)
  zone=$(cfg CF_ZONE_ID)

  info "This stops '$name' and deletes its DNS record, tunnel and Access application."
  if has_vault "$name"; then
    info "Its vault (the people's saved personal data) is deleted too: its volume goes with the stack."
  fi
  if has_receipts "$name"; then
    info "Its pipelock receipts and their signing key are deleted too; keep a backup if you need them."
  fi
  state=$(env_get "$f" LETTA_STATE_DIR)
  if has_profile "$(env_get "$f" COMPOSE_PROFILES)" gmail-triggers || [[ -n $state && -d $state/garden/gmail-triggers ]]; then
    info "Its Gmail triggers stop with it; their rules are in its state, so they go only with --purge."
  fi
  if [[ -n $purge && -n $state && -L $state/garden ]]; then
    # Docker would follow it, and the purge would empty whatever it points at.
    die "$state/garden is a symlink; remove it by hand, then purge again"
  fi
  if [[ -n $purge ]]; then
    info "--purge also deletes ALL of its data (agents, memory, conversations): $(stack_dir "$name")"
  else
    info "Its data stays in $(stack_dir "$name")."
  fi
  printf 'Type the stack name to confirm: ' >&2
  read -r answer || true
  [[ $answer == "$name" ]] || die "aborted"

  compose "$name" down -v || warn "docker compose down failed; continuing"
  local left=()
  id=$(env_get "$f" CF_DNS_RECORD_ID)
  if [[ -n $id ]]; then
    if cf_api DELETE "/zones/$zone/dns_records/$id" >/dev/null; then env_unset "$f" CF_DNS_RECORD_ID; else left+=("DNS record $id"); fi
  fi
  id=$(env_get "$f" CF_TUNNEL_ID)
  if [[ -n $id ]]; then
    cf_api DELETE "/accounts/$acc/cfd_tunnel/$id/connections" >/dev/null || true
    if cf_api DELETE "/accounts/$acc/cfd_tunnel/$id" >/dev/null; then
      env_unset "$f" CF_TUNNEL_ID
      env_unset "$f" CLOUDFLARE_TUNNEL_TOKEN
    else
      left+=("tunnel $id")
    fi
  fi
  id=$(env_get "$f" CF_ACCESS_APP_ID)
  if [[ -n $id ]]; then
    if cf_api DELETE "/accounts/$acc/access/apps/$id" >/dev/null; then
      env_unset "$f" CF_ACCESS_APP_ID
      env_unset "$f" CF_ACCESS_AUD
    else
      left+=("Access application $id")
    fi
  fi
  id=$(env_get "$f" CF_ACCESS_POLICY_ID)
  if [[ -n $id ]]; then
    if cf_api DELETE "/accounts/$acc/access/policies/$id" >/dev/null; then env_unset "$f" CF_ACCESS_POLICY_ID; else left+=("Access policy $id"); fi
  fi

  if ((${#left[@]})); then
    warn "not deleted (already gone, or delete it in the Cloudflare dashboard): ${left[*]}"
    warn "their ids stay in stacks/$name/stack.env, so 'lettucectl remove $name' can retry"
  fi
  if has_profile "$(cfg PROFILES)" google; then
    info "Google: delete $(google_redirect_uri "$name") from your Google OAuth client's redirect URIs"
  fi
  if [[ -n $purge ]]; then
    if ((${#left[@]})); then
      warn "keeping stacks/$name because Cloudflare resources are left; purge again after they are gone"
      return 0
    fi
    # The state is root-owned (the app-server runs as root), so it is emptied
    # from inside the stack's own image; the empty directories then go without sudo.
    # Gmail trigger rules are outside the app-server's mounts, so they get one here.
    local garden
    local -a extra=() dirs=(/root/.letta /data /work)
    garden=$state/garden
    if [[ -n $state && -d $garden ]]; then
      extra=(-v "$garden:/garden")
      dirs+=(/garden)
    fi
    compose "$name" run --rm --no-deps -T "${extra[@]}" --entrypoint find app-server \
      "${dirs[@]}" -mindepth 1 -delete || die "could not empty the state of '$name'"
    # `run` recreated the project network; remove it again before the env file goes.
    compose "$name" down || warn "could not remove the network of '$name'"
    rm -rf "$(stack_dir "$name")"
    info "'$name' removed, data included"
  else
    info "'$name' removed from Cloudflare; data kept in $(stack_dir "$name")"
  fi
}

cmd_profiles() {
  (($# <= 1)) || die "usage: lettucectl profiles [<profile>,<profile>...]"
  local new n changed="" stale running
  local -a stacks gone failed=() unrouted=() executors=()
  mapfile -t stacks < <(list_stacks)
  if (($# == 0)); then
    require_config
    printf '%-20s %s\n' config.env "$(cfg PROFILES)"
    for n in "${stacks[@]}"; do
      printf '%-20s %s\n' "$n" "$(env_get "$(stack_env "$n")" COMPOSE_PROFILES)"
    done
    return 0
  fi
  require_initialised
  new=$(normalise_profiles "$1")
  [[ $(cfg PROFILES) == "$new" ]] || changed=1
  for n in "${stacks[@]}"; do
    [[ $(env_get "$(stack_env "$n")" COMPOSE_PROFILES) == "$new" ]] || changed=1
  done

  if [[ -n $changed ]]; then
    # Check every stack, as it will be under the new list, before writing
    # anything, so one broken stack cannot leave the others half-switched.
    for n in "${stacks[@]}"; do
      ensure_push_keys "$n"
      ensure_executor_token "$n"
      check_stack "$n" --profiles "$new"
    done
    for n in "${stacks[@]}"; do
      env_set "$(stack_env "$n")" COMPOSE_PROFILES "$new"
    done
    env_set "$(config_file)" PROFILES "$new"
    info "profiles for every stack: $new"
  fi

  # The tunnel routes each garden page only with its profile. Applied on
  # every run, before the stacks start, so a re-run repairs a failed update.
  for n in "${stacks[@]}"; do
    route_stack "$n" || unrouted+=("$n")
  done

  if [[ -n $changed ]]; then
    for n in "${stacks[@]}"; do
      up_stack "$n"
    done
  else
    info "profiles are already $new everywhere; nothing to change"
  fi

  # Compose leaves the containers of a dropped profile running. This looks at
  # what exists rather than at what changed, so a re-run also clears what an
  # interrupted run left behind.
  for n in "${stacks[@]}"; do
    stale=$(stale_services "$n")
    [[ -n $stale ]] || continue
    mapfile -t gone <<<"$stale"
    info "$n: removing ${gone[*]} (their profile is off)"
    compose "$n" rm -sf "${gone[@]}" || failed+=("$n")
  done
  # The executor follows the profile on every running stack, on every run, so a
  # re-run repairs a failed install or removal; a stopped stack gets it right
  # at its next `up`.
  for n in "${stacks[@]}"; do
    if ! has_profile "$new" gmail-triggers && ! executor_installed "$n"; then
      continue
    fi
    running=$(compose "$n" ps --status running --services) || {
      executors+=("$n")
      continue
    }
    if ! grep -qx app-server <<<"$running"; then
      if has_profile "$new" gmail-triggers; then
        info "$n: not running; its executor is installed at its next up"
      else
        info "$n: not running; its executor is removed at its next up"
      fi
      continue
    fi
    sync_executor "$n" || executors+=("$n")
  done

  if has_profile "$new" google; then
    for n in "${stacks[@]}"; do
      google_reminder "$n"
    done
  fi
  ((${#unrouted[@]} == 0)) || warn "could not update the tunnel routes of: ${unrouted[*]}"
  ((${#failed[@]} == 0)) || warn "could not remove the containers of dropped profiles in: ${failed[*]}"
  ((${#executors[@]} == 0)) || warn "could not sync the gmail-triggers executor of: ${executors[*]}"
  ((${#unrouted[@]} + ${#failed[@]} + ${#executors[@]} == 0)) || die "run the same command again"
}

cmd_upgrade() {
  (($# == 1)) || die "usage: lettucectl upgrade <tag>"
  local ref=$1 up
  require_config
  up=$(upstream_dir)
  [[ -d $up/.git ]] || die "upstream/ is not a git checkout"
  git -C "$up" fetch -q --tags
  git -C "$up" -c advice.detachedHead=false checkout -q "$ref"
  env_set "$(config_file)" LETTUCE_REF "$ref"
  info "upstream now at $ref; rebuilding every stack"
  cmd_up all
}

cmd_up() {
  (($# == 1)) || die "usage: lettucectl up <name|all>"
  local n targets unsynced=()
  require_initialised
  targets=$(expand_targets "$1")
  for n in $targets; do
    up_stack "$n"
    sync_executor "$n" || unsynced+=("$n")
  done
  ((${#unsynced[@]} == 0)) || executor_out_of_step "${unsynced[@]}"
}

cmd_down() {
  (($# == 1)) || die "usage: lettucectl down <name|all>"
  local n targets
  targets=$(expand_targets "$1")
  for n in $targets; do
    compose "$n" down
  done
}

cmd_restart() {
  (($# == 1)) || die "usage: lettucectl restart <name|all>"
  cmd_down "$1"
  cmd_up "$1"
}

cmd_check() {
  (($# == 1)) || die "usage: lettucectl check <name|all>"
  local n targets
  require_initialised
  targets=$(expand_targets "$1")
  for n in $targets; do
    check_stack "$n"
    info "$n: ok"
  done
}

cmd_status() {
  local n
  while read -r n; do
    printf '== %s  https://%s\n' "$n" "$(env_get "$(stack_env "$n")" LETTUCE_HOSTNAME)"
    compose "$n" ps --format 'table {{.Service}}\t{{.Status}}'
  done < <(list_stacks)
}

cmd_list() {
  local n f
  while read -r n; do
    f=$(stack_env "$n")
    printf '%-20s https://%-40s %s\n' "$n" "$(env_get "$f" LETTUCE_HOSTNAME)" "$(env_get "$f" ALLOWED_USERS)"
  done < <(list_stacks)
}

cmd_logs() {
  (($# >= 1)) || die "usage: lettucectl logs <name> [service]"
  validate_name "$1"
  require_stack "$1"
  compose "$1" logs -f --tail=200 "${@:2}"
}

cmd_compose() {
  (($# >= 2)) || die "usage: lettucectl compose <name> <args...>"
  validate_name "$1"
  require_stack "$1"
  compose "$@"
}

# find_agent NAME AGENT -> "<id>\t<name>" of the stack's agent whose id, or name
# ignoring case, is AGENT; dies when none or several match
find_agent() {
  local list matches
  # letta exits before flushing a pipe past 64 KiB, and each agent carries its
  # whole system prompt, so the list goes through a file in the container.
  # stdin stays for the shell: `compose exec` would forward it here.
  # shellcheck disable=SC2016 # expanded by sh in the container
  list=$(compose "$1" exec -T app-server sh -c \
    'f=$(mktemp); letta agents list --limit 1000 >"$f"; rc=$?; cat "$f"; rm -f "$f"; exit $rc' </dev/null) ||
    die "$1: could not list agents (is the stack up?)"
  matches=$(jq -r --arg a "$2" \
    '.items[] | select(.id == $a or (.name | ascii_downcase) == ($a | ascii_downcase)) | "\(.id)\t\(.name)"' \
    <<<"$list") || die "$1: unexpected output from 'letta agents list'"
  case $(grep -c . <<<"$matches") in
    0) die "$1 has no agent '$2'; agents: $(jq -r '[.items[].name] | join(", ")' <<<"$list")" ;;
    1) printf '%s' "$matches" ;;
    *) die "$1 has several agents named '$2'; use an id: $(cut -f1 <<<"$matches" | paste -sd' ')" ;;
  esac
}

# open_agent NAME AGENT -> sets the caller's id, ws (the workspace on the host)
# and agent_env (what letta-code sets for the agent's Bash tool, as -e options);
# dies when the agent or its workspace does not exist
open_agent() {
  local agent agent_name
  agent=$(find_agent "$1" "$2")
  id=${agent%%$'\t'*}
  agent_name=${agent#*$'\t'}
  ws=$(env_get "$(stack_env "$1")" LETTA_STATE_DIR)/workspaces/$id
  [[ -d $ws ]] || die "$1: no workspace for $agent_name at $ws"
  agent_env=(-e "AGENT_ID=$id" -e "LETTA_AGENT_ID=$id" -e "AGENT_NAME=$agent_name" -e "USER_CWD=/work/$id")
  info "$1: $agent_name ($id)"
}

# Close to, not the same as, an agent's Bash tool: letta-code also sets the
# conversation id, per-agent secrets and a few PATH entries.
cmd_shell() {
  (($# == 1 || $# == 2)) || die "usage: lettucectl shell <name> [agent]"
  validate_name "$1"
  require_stack "$1"
  local tty=() id ws agent_env=()
  [[ -t 0 && -t 1 ]] || tty=(-T)
  if (($# == 1)); then
    compose "$1" exec "${tty[@]}" -w /work app-server bash
    return
  fi
  open_agent "$1" "$2"
  # The memory path is letta-code's local-backend layout (getLocalBackendMemoryFilesystemRoot).
  # shellcheck disable=SC2016 # expanded by bash in the container
  compose "$1" exec "${tty[@]}" -w "/work/$id" "${agent_env[@]}" \
    app-server bash -c 'export MEMORY_DIR=$LETTA_LOCAL_BACKEND_DIR/memfs/$AGENT_ID/memory
export LETTA_MEMORY_DIR=$MEMORY_DIR
exec bash'
}

# ── toolbox ──────────────────────────────────────────────────────────────────
# `toolbox` works on an agent's workspace with the operator's own tools from a
# throwaway container. Agents run in the app-server, so unlike `shell` nothing it
# brings in is visible to them. The helpers below add to cmd_toolbox's arrays.
# The agents' installed tools are mounted only with --tools (read-only unless rw):
# every agent writes them, and here they would run with the operator's credentials.

toolbox_file() { printf '%s/lettucectl/toolbox' "${XDG_CONFIG_HOME:-$HOME/.config}"; }

# tilde PATH HOME -> PATH with a leading ~ replaced by HOME
tilde() {
  # shellcheck disable=SC2088 # matching a literal ~ from the toolbox file
  case $1 in
    "~") printf '%s' "$2" ;;
    "~/"*) printf '%s/%s' "$2" "${1#"~/"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# toolbox_mount SRC DEST ro|rw
toolbox_mount() {
  [[ -e $1 ]] || die "toolbox: $1 does not exist"
  [[ $1 == /* && $2 == /* ]] || die "toolbox: mount paths must be absolute: $1 $2"
  [[ $1$2 != *:* ]] || die "toolbox: mount paths cannot contain ':': $1 $2"
  run+=(-v "$1:$2:$3")
}

# toolbox_secret NAME VALUE -> passed to the container by name, never in argv; a
# later value for the same NAME replaces the earlier one
toolbox_secret() {
  local i
  for i in "${!secret_names[@]}"; do
    if [[ ${secret_names[i]} == "$1" ]]; then
      secret_values[i]=$2
      return
    fi
  done
  secret_names+=("$1")
  secret_values+=("$2")
}

# toolbox_builtins -> what every operator gets, each only when the host has it
toolbox_builtins() {
  local claude=${CLAUDE_CONFIG_DIR:-$HOME/.claude} f tok found=""
  if [[ -n ${SSH_AUTH_SOCK:-} && -e $SSH_AUTH_SOCK ]]; then
    run+=(-v "$SSH_AUTH_SOCK:/run/ssh-agent.sock" -e SSH_AUTH_SOCK=/run/ssh-agent.sock)
    have+=(ssh-agent)
  fi
  if [[ -f $HOME/.ssh/known_hosts ]]; then
    toolbox_mount "$HOME/.ssh/known_hosts" /root/.ssh/known_hosts ro
  fi
  if [[ -f $HOME/.gitconfig ]]; then
    toolbox_mount "$HOME/.gitconfig" /root/.gitconfig ro
    have+=(git)
  fi
  if command -v gh >/dev/null && tok=$(gh auth token 2>/dev/null </dev/null) && [[ -n $tok ]]; then
    # The host's credential helper may call gh by a path the image does not have.
    run+=(-e GIT_CONFIG_COUNT=2
      -e GIT_CONFIG_KEY_0=credential.https://github.com.helper -e GIT_CONFIG_VALUE_0=
      -e GIT_CONFIG_KEY_1=credential.https://github.com.helper -e "GIT_CONFIG_VALUE_1=!gh auth git-credential")
    toolbox_secret GH_TOKEN "$tok"
    have+=(gh)
  fi
  for f in CLAUDE.md settings.json skills agents commands; do
    if [[ -e $claude/$f ]]; then
      toolbox_mount "$claude/$f" "/root/.claude/$f" ro
      found=1
    fi
  done
  [[ -z $found ]] || have+=("claude config")
  tok=${CLAUDE_CODE_OAUTH_TOKEN:-}
  if [[ -z $tok ]] && command -v secret-tool >/dev/null; then
    tok=$(secret-tool lookup service claude-toolbox 2>/dev/null </dev/null) || tok=""
  fi
  if [[ -n $tok ]]; then
    toolbox_secret CLAUDE_CODE_OAUTH_TOKEN "$tok"
    have+=("claude token")
  fi
}

# toolbox_personal FILE -> the operator's own additions; parsed, never sourced.
# One per line, words split on spaces:
#   mount SRC [DEST] [rw]       read-only unless rw; DEST defaults to SRC
#   secret NAME COMMAND [ARG]   NAME is set to the command's output, by name only
#   env NAME=VALUE              a plain variable
# ~ is the operator's home in SRC and commands, and /root in DEST.
toolbox_personal() {
  local file=$1 line w a n=0 src dest mode val name
  [[ -f $file ]] || return 0
  [[ -O $file ]] || die "$file is not owned by you"
  ((((8#$(file_mode "$file")) & 8#022) == 0)) || die "$file is writable by others (chmod 600 $file)"
  while IFS= read -r line || [[ -n $line ]]; do
    read -ra w <<<"$line"
    [[ ${#w[@]} == 0 || ${w[0]} == \#* ]] && continue
    case ${w[0]} in
      mount)
        a=("${w[@]:1}")
        mode=ro
        if ((${#a[@]} > 1)) && [[ ${a[-1]} == rw ]]; then
          mode=rw
          unset 'a[-1]'
        fi
        ((${#a[@]} == 1 || ${#a[@]} == 2)) || die "$file: expected 'mount SRC [DEST] [rw]': $line"
        src=$(tilde "${a[0]}" "$HOME")
        dest=$src
        [[ -z ${a[1]:-} ]] || dest=$(tilde "${a[1]}" /root)
        toolbox_mount "$src" "$dest" "$mode"
        ;;
      secret)
        name=${w[1]:-}
        ((${#w[@]} >= 3)) && [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] ||
          die "$file: expected 'secret NAME COMMAND [ARG...]': $line"
        a=()
        for val in "${w[@]:2}"; do a+=("$(tilde "$val" "$HOME")"); done
        val=$("${a[@]}" </dev/null) || die "$file: secret $name: '${a[*]}' failed"
        [[ -n $val ]] || die "$file: secret $name: '${a[*]}' printed nothing"
        toolbox_secret "$name" "$val"
        ;;
      env)
        ((${#w[@]} == 2)) && [[ ${w[1]} =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] ||
          die "$file: expected 'env NAME=VALUE': $line"
        run+=(-e "${w[1]}")
        ;;
      *) die "$file: unknown directive '${w[0]}': $line" ;;
    esac
    n=$((n + 1))
  done <"$file"
  ((n == 0)) || have+=("+$n from $file")
}

cmd_toolbox() {
  local usage="usage: lettucectl toolbox [--tools[=rw]] <name> <agent> [command...]" tools=""
  case ${1:-} in
    --tools) tools=ro ;;
    --tools=rw) tools=rw ;;
    --*) die "$usage" ;;
  esac
  [[ -z $tools ]] || shift
  (($# >= 2)) || die "$usage"
  validate_name "$1"
  require_stack "$1"
  local name=$1 id ws state image config path mask i run=() agent_env=() secret_names=() secret_values=() have=() argv=("${@:3}")
  open_agent "$name" "$2"
  if [[ -n $tools ]]; then
    # Docker would create a missing bind source as root; the app-server's `up` does that.
    state=$(env_get "$(stack_env "$name")" LETTA_STATE_DIR)
    [[ -d $state/tools ]] || die "$name: no agent tools at $state/tools yet; run: lettucectl up $name"
  fi
  image=$(compose "$name" config --format json | jq -r '.services["app-server"].image // empty') ||
    die "$name: docker compose config failed"
  [[ -n $image ]] || die "$name: the compose config has no app-server image"
  config=$(host_docker image inspect --format '{{json .Config}}' "$image") ||
    die "$name: no image $image; run: lettucectl up $name"
  path=$(jq -r '.Env // [] | map(select(startswith("PATH="))) | .[0] // "" | ltrimstr("PATH=")' <<<"$config")
  [[ -n $path ]] || die "$name: image $image sets no PATH"

  run=(run --rm --init -i)
  if [[ -t 0 && -t 1 ]]; then run+=(-t); fi
  # Or Compose and `stale_services` would take it for an app-server container.
  mapfile -t mask < <(compose_label_mask "$config")
  run+=("${mask[@]}")
  # shellcheck disable=SC2054 # the commas are tmpfs options
  run+=(--hostname "toolbox-$name" --label "lettucectl.toolbox=$name" --label "lettucectl.agent=$id"
    --security-opt no-new-privileges --memory 8g --pids-limit 4096
    --tmpfs /root:mode=700,exec --tmpfs /tmp:exec
    -v "$ws:/work/$id" -w "/work/$id" "${agent_env[@]}"
    -e "PATH=/opt/claude-code/bin:$path")
  # The image already points PATH and the package managers at /opt/agent-tools.
  [[ -z $tools ]] || run+=(-v "$state/tools:/opt/agent-tools:$tools")
  toolbox_builtins
  toolbox_personal "$(toolbox_file)"
  case $tools in
    ro) have+=("agent tools (read-only)") ;;
    rw) have+=("agent tools (writable)") ;;
  esac
  for i in "${!secret_names[@]}"; do run+=(-e "${secret_names[i]}"); done

  if ((${#have[@]})); then
    info "toolbox: $(printf '%s, ' "${have[@]}" | sed 's/, $//')"
  else
    info "toolbox: nothing of yours found"
  fi
  [[ " ${secret_names[*]} " == *" CLAUDE_CODE_OAUTH_TOKEN "* ]] ||
    warn "no Claude token, so claude will ask you to log in; to set one up once: claude setup-token, then: secret-tool store --label='Claude toolbox' service claude-toolbox"
  # Secrets reach docker through its environment, so they never show in argv
  # (which `env -i NAME=value` would do); `-e NAME` copies each one.
  (
    for i in "${!secret_names[@]}"; do export "${secret_names[i]}=${secret_values[i]}"; done
    exec docker "${run[@]}" "$image" "${argv[@]:-bash}"
  )
}

# ── backup ───────────────────────────────────────────────────────────────────
# `backup` copies what the images cannot recreate (agents, memory, conversations,
# workspaces, agent-installed tools, Settings skills, the vault and stack.env) to
# <dir>/<name>/: a dated rsync snapshot that hard-links files unchanged since the
# previous one, or with --compress a tar.gz. The state is root-owned, so it is
# read in a throwaway container of backup/Dockerfile. The helpers below read
# cmd_backup's settings (dest, compress, tools, when, keep).

BACKUP_IMAGE=lettuce-backup:local
# No network, and only the capabilities copying needs: read everything, write
# into the operator's directory and hand the copies to the operator (--chown).
# --init: as PID 1, sh would ignore the signal docker forwards on Ctrl-C.
BACKUP_RUN=(run --rm --init --network none --read-only --tmpfs /tmp --security-opt no-new-privileges
  --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER)
# A backup's name: its UTC start time, which sorts by age.
BACKUP_TS='[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z'

# Run by sh in the backup container as: sh -c "$BACKUP_COPY" sh MODE SRC DST OWNER
# PREV OUT EXCLUDE... MODE rsync copies SRC to DST/OUT owned by OWNER, hard-linking
# files unchanged since DST/PREV; MODE tar writes a tar.gz of SRC to stdout, with
# the real owners a restore needs. EXCLUDEs are relative to SRC. The skills
# lettucectl installed are left out too (`skills` reinstalls them); their manifest
# is read here because the host may not be allowed to.
# shellcheck disable=SC2016 # expanded by sh in the container
BACKUP_COPY='set -e
mode=$1 src=$2 dst=$3 owner=$4 prev=$5 out=$6
shift 6
x=$(mktemp)
for p in "$@"; do printf "%s\n" "$p"; done >"$x"
m=$src/state/letta-home/skills/.lettucectl-skills
if [ -f "$m" ]; then
  echo state/letta-home/skills/.lettucectl-skills >>"$x"
  while read -r s; do
    if [ -n "$s" ]; then echo "state/letta-home/skills/$s" >>"$x"; fi
  done <"$m"
fi
rc=0
if [ "$mode" = tar ]; then
  sed "s|^|./|" "$x" >"$x.tar"
  tar -C "$src" --numeric-owner --anchored -X "$x.tar" -czf - . || rc=$?
  # 1: a file changed while it was read, as in a live copy; the archive is complete.
  if [ "$rc" = 1 ]; then echo "warning: files changed during the copy" >&2; rc=0; fi
else
  sed "s|^|/|" "$x" >"$x.rsync"
  rsync -aH --numeric-ids --chown="$owner" --exclude-from="$x.rsync" \
    ${prev:+--link-dest="$dst/$prev"} "$src/" "$dst/$out/" || rc=$?
  # 24: files vanished while copying, as in a live copy.
  if [ "$rc" = 24 ]; then echo "warning: files vanished during the copy" >&2; rc=0; fi
fi
exit "$rc"'

# backup_list DIR SUFFIX -> DIR's snapshots (SUFFIX "") or archives (SUFFIX
# .tar.gz), oldest first
backup_list() {
  local p
  # shellcheck disable=SC2086 # BACKUP_TS is a glob
  for p in "$1"/$BACKUP_TS"$2"; do
    if [[ -e $p ]]; then printf '%s\n' "${p##*/}"; fi
  done
}

# backup_rm NAME DIR ENTRY... -> deletes DIR's entries from the container: a
# snapshot can hold read-only directories (Go's module cache) the operator cannot empty
backup_rm() {
  local name=$1 dir=$2 e paths=()
  shift 2
  (($#)) || return 0
  for e in "$@"; do paths+=("/dst/$e"); done
  host_docker "${BACKUP_RUN[@]}" --label "lettucectl.backup=$name" -v "$dir:/dst" "$BACKUP_IMAGE" \
    rm -rf -- "${paths[@]}" || die "$name: could not delete $* in $dir"
}

# backup_choice NAME -> pause|live for a running stack: --pause or --live, else the
# operator's answer
backup_choice() {
  local answer=""
  if [[ -n $when ]]; then
    printf '%s' "$when"
    return
  fi
  info "$1 is running. A live copy can catch memory repos, conversations or the vault mid-write and"
  info "leave a corrupt backup; pausing is recommended (agents and the UI freeze until the copy ends)."
  info "  [p] pause $1 while copying   [l] copy live anyway (not recommended)   [a] abort"
  printf 'Choice [p/l/a]: ' >&2
  read -r answer || true
  case $answer in
    p | P) printf pause ;;
    l | L) printf live ;;
    *) die "aborted (to answer ahead of time, as from cron: --pause or --live)" ;;
  esac
}

# backup_prune NAME DIR -> keeps DIR's newest $keep backups of the kind just made
backup_prune() {
  local name=$1 dir=$2 p old=()
  if [[ -n $compress ]]; then
    mapfile -t old < <(backup_list "$dir" .tar.gz | head -n -"$keep")
    for p in "${old[@]}"; do rm -f -- "${dir:?}/$p"; done
  else
    mapfile -t old < <(backup_list "$dir" "" | head -n -"$keep")
    backup_rm "$name" "$dir" "${old[@]}"
  fi
  ((${#old[@]} == 0)) || info "$name: removed ${#old[@]} older backup(s): ${old[*]}"
}

# backup_stack NAME -> one backup of the stack into $dest/NAME. Run in a subshell:
# the lock it takes is released when that exits.
backup_stack() {
  local name=$1 f state dir ts prev s p lock vol choice="" mounts=() excludes=() stale=()
  f=$(stack_env "$name")
  state=$(env_get "$f" LETTA_STATE_DIR)
  [[ -d $state ]] || die "$name: no state directory at $state"
  dir=$dest/$name
  (umask 077 && mkdir -p "$dir")
  # A second run would take this one's .partial-* for a leftover and delete it.
  exec {lock}>"$dir/.lock"
  flock -n "$lock" || die "$name: another backup of $name is running"
  mounts=(--label "lettucectl.backup=$name" -v "$state:/src/state:ro" -v "$f:/src/stack.env:ro")
  # Turning the secrets profile off keeps the volume, so look for it either way;
  # `run -v` would create a missing one.
  vol=$(vault_volume "$name")
  if has_vault "$name"; then
    mounts+=(-v "$vol:/src/vault:ro")
  elif has_profile "$(env_get "$f" COMPOSE_PROFILES)" secrets; then
    warn "$name: the vault volume $vol does not exist yet; backing up without it"
  fi
  if has_receipts "$name"; then
    mounts+=(-v "$(receipts_volume "$name"):/src/pipelock:ro")
  fi
  excludes=(state/letta-home/mod-cache state/letta-home/claude/paste-cache state/letta-home/claude/backups)
  # The BFF rewrites upstream's skills on every connect.
  for s in "$(upstream_dir)"/docker/agent-skills/*/; do
    if [[ -d $s ]]; then
      s=${s%/}
      excludes+=("state/letta-home/skills/${s##*/}")
    fi
  done
  [[ -n $tools ]] || excludes+=(state/tools)

  # What an interrupted run left behind.
  for p in "$dir"/.partial-*; do
    if [[ -e $p ]]; then stale+=("${p##*/}"); fi
  done
  backup_rm "$name" "$dir" "${stale[@]}"
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  [[ ! -e $dir/$ts && ! -e $dir/$ts.tar.gz ]] || die "$name: $dir/$ts already exists; run again in a second"
  if stack_running "$name"; then
    choice=$(backup_choice "$name")
  fi
  (
    if [[ $choice == pause ]]; then
      info "$name: paused while copying"
      # Set first: a pause that fails partway leaves some containers paused.
      trap 'compose "$name" unpause >/dev/null || warn "$name: could not unpause it; run: lettucectl compose $name unpause"' EXIT
      trap 'exit 130' INT TERM
      compose "$name" pause >/dev/null || die "$name: could not pause the stack"
    fi
    if [[ -n $compress ]]; then
      if ! (umask 077 && host_docker "${BACKUP_RUN[@]}" "${mounts[@]}" "$BACKUP_IMAGE" \
        sh -c "$BACKUP_COPY" sh tar /src "" "" "" "" "${excludes[@]}" >"$dir/.partial-$ts.tar.gz"); then
        rm -f "$dir/.partial-$ts.tar.gz"
        die "$name: the copy failed"
      fi
      mv "$dir/.partial-$ts.tar.gz" "$dir/$ts.tar.gz"
    else
      prev=$(backup_list "$dir" "" | tail -n 1)
      host_docker "${BACKUP_RUN[@]}" "${mounts[@]}" -v "$dir:/dst" "$BACKUP_IMAGE" \
        sh -c "$BACKUP_COPY" sh rsync /src /dst "$(id -u):$(id -g)" "$prev" ".partial-$ts" "${excludes[@]}" ||
        die "$name: the copy failed; the next run removes $dir/.partial-$ts"
      mv "$dir/.partial-$ts" "$dir/$ts"
    fi
  )
  info "$name: $dir/$ts${compress:+.tar.gz}"
  [[ -z $keep ]] || backup_prune "$name" "$dir"
}

cmd_backup() {
  local usage="usage: lettucectl backup <name|all> <dir> [--compress] [--no-tools] [--pause|--live] [--keep N]"
  local dest compress="" tools=1 when="" keep="" n rc targets args=() failed=()
  while (($#)); do
    case $1 in
      --compress) compress=1 ;;
      --no-tools) tools="" ;;
      --pause | --live)
        [[ -z $when || $when == "${1#--}" ]] || die "use --pause or --live, not both"
        when=${1#--}
        ;;
      --keep)
        [[ ${2:-} =~ ^[1-9][0-9]*$ ]] || die "--keep needs how many backups to keep, 1 or more"
        keep=$2
        shift
        ;;
      -*) die "$usage" ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  ((${#args[@]} == 2)) || die "$usage"
  require_initialised
  targets=$(expand_targets "${args[0]}")
  dest=${args[1]}
  [[ $dest != *[:,]* ]] || die "the destination cannot contain ':' or ','; backup writes to a local directory"
  [[ -d $dest ]] || die "$dest is not a directory"
  dest=$(realpath "$dest")
  [[ $dest != *[:,]* ]] || die "the destination cannot contain ':' or ',': $dest"
  # This repo is public, and a backup holds stack.env and the agents' logins.
  [[ $dest/ != "$LETTUCE_HOME"/* ]] || die "the destination cannot be inside $LETTUCE_HOME"
  command -v flock >/dev/null || die "flock is required but not installed (util-linux)"
  host_docker build -q -t "$BACKUP_IMAGE" "$LETTUCE_HOME/backup" >/dev/null ||
    die "could not build $BACKUP_IMAGE (backup/Dockerfile)"
  # One stack failing must not cost the others their backup, but Ctrl-C stops
  # them all (the trap runs once the stack's subshell is done). errexit is off
  # inside a subshell that is part of `||` or `if`, so the status is read after.
  trap 'exit 130' INT TERM
  for n in $targets; do
    set +e
    (
      set -e
      backup_stack "$n"
    )
    rc=$?
    set -e
    ((rc == 0)) || failed+=("$n")
  done
  if ((${#failed[@]})); then
    [[ ${args[0]} != all ]] || die "backup failed for: ${failed[*]}"
    exit 1
  fi
}

# ── receipts ─────────────────────────────────────────────────────────────────
PIPELOCK_IMAGE=lettuce-pipelock:local
PIPELOCK_KEY_PUB=/data/keys/receipt-signing.json.pub
PIPELOCK_RUN=()

# pipelock_setup NAME -> sets PIPELOCK_RUN to the `docker run` options of
# pipelock_run: no network, no capabilities, the volume read-only, and the
# image's Compose labels emptied (compose_label_mask), so Compose and
# stale_services don't take its containers for the stack's pipelock
pipelock_setup() {
  local name=$1 config mask
  config=$(host_docker image inspect "$PIPELOCK_IMAGE" --format '{{json .Config}}') ||
    die "$name: no $PIPELOCK_IMAGE image; run lettucectl up $name with the pipelock profile"
  mapfile -t mask < <(compose_label_mask "$config")
  PIPELOCK_RUN=(--rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges
    "${mask[@]}" --label "lettucectl.receipts=$name" -v "$(receipts_volume "$name"):/data:ro")
}

# pipelock_run ENTRYPOINT ARGS... -> a one-off container of the pipelock image
# (after pipelock_setup)
pipelock_run() {
  local entry=$1
  shift
  host_docker run "${PIPELOCK_RUN[@]}" --entrypoint "$entry" "$PIPELOCK_IMAGE" "$@"
}

# receipts_verify NAME -> verifies every receipt and prints pipelock's report.
# pipelock refuses a file that changes while it reads it, which a running
# pipelock does with every request, so a failure is retried twice.
receipts_verify() {
  local name=$1 out i
  for i in 1 2 3; do
    ((i == 1)) || sleep 1
    if out=$(pipelock_run pipelock verify-receipt --whole-recorder --chain /data/evidence --key "$PIPELOCK_KEY_PUB" 2>&1); then
      printf '%s\n' "$out"
      return 0
    fi
  done
  printf '%s\n' "$out" >&2
  if compose "$name" ps --status running --services | grep -qx pipelock; then
    die "$name: the receipts do not verify, but pipelock is running and may have written to them during each check; retry when the stack is quiet, or after: lettucectl down $name"
  fi
  die "$name: the receipts do not verify"
}

# receipt_sessions NAME -> "<epoch> <session>" per pipelock run, newest first.
# Each start of the proxy is a session, written as evidence-<session>-<n>.jsonl.
receipt_sessions() {
  # shellcheck disable=SC2016 # expanded by sh in the container
  pipelock_run sh -c 'for f in /data/evidence/evidence-*.jsonl; do [ -e "$f" ] && stat -c "%Y %n" "$f"; done; true' |
    sed -E 's#^([0-9]+) /data/evidence/evidence-(.*)-[0-9]+\.jsonl$#\1 \2#' |
    sort -rn | awk '!seen[$2]++'
}

cmd_receipts() {
  local usage="usage: lettucectl receipts <name> [<file.html> [<session>]]"
  local name=${1:-} report=${2:-} session=${3:-} sessions t s tmp
  [[ -n $name && $# -le 3 ]] || die "$usage"
  validate_name "$name"
  require_stack "$name"
  has_receipts "$name" || die "$name: no pipelock receipts (its volume $(receipts_volume "$name") does not exist)"
  pipelock_setup "$name"
  sessions=$(receipt_sessions "$name") || die "$name: could not list the receipts"
  [[ -n $sessions ]] || die "$name: pipelock has written no receipts yet"
  if [[ -z $report ]]; then
    receipts_verify "$name"
    info "sessions (one per start of pipelock), newest first:"
    while read -r t s; do
      printf '%s  %s\n' "$(date -d "@$t" '+%F %T')" "$s"
    done <<<"$sessions"
    return 0
  fi
  if [[ -z $session ]]; then
    session=$(head -n 1 <<<"$sessions" | cut -d' ' -f2)
  else
    awk -v s="$session" '$2 == s { f = 1 } END { exit !f }' <<<"$sessions" || die "$name: no session $session"
  fi
  [[ -d $(dirname -- "$report") ]] || die "$(dirname -- "$report") is not a directory"
  # This repo is public, and receipts name every site the agents reached.
  [[ $(realpath -m -- "$report") != "$LETTUCE_HOME"/* ]] || die "the report cannot be inside $LETTUCE_HOME"
  # Written beside it (mktemp makes it 600) and renamed: an existing file
  # takes the new mode, and survives a failure.
  tmp=$(mktemp "$(dirname -- "$report")/.receipts.XXXXXX") || die "could not write in $(dirname -- "$report")"
  if ! pipelock_run pipelock evidence view --receipt-dir /data/evidence \
    --session "$session" --trusted-signer "file=$PIPELOCK_KEY_PUB" >"$tmp" || ! mv -f -- "$tmp" "$report"; then
    rm -f -- "$tmp"
    die "$name: could not write the report"
  fi
  info "$name: session $session -> $report"
}

cmd_skills() {
  (($# == 1)) || die "usage: lettucectl skills <name|all>"
  local n targets k
  targets=$(expand_targets "$1")
  for n in $targets; do
    k=$(sync_skills "$n")
    info "$n: $k skill(s) installed"
  done
}

main() {
  local cmd=${1:-help}
  shift || true
  case $cmd in
    init | add | users | remove | profiles | upgrade | up | down | restart | check | status | list | logs | compose | shell | toolbox | skills | backup | receipts)
      "cmd_$cmd" "$@"
      ;;
    help | -h | --help) usage ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
