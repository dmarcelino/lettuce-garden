#!/usr/bin/env bash
# Test stub for docker: records the call and answers the few queries lettucectl makes.
# Settings come from $STUB_ROOT/stub.env, not the environment: lettucectl runs
# docker under `env -i`. Tests copy the stubs to $STUB_ROOT/bin.
STUB_ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=/dev/null
[[ -f $STUB_ROOT/stub.env ]] && . "$STUB_ROOT/stub.env"
STUB_LOG=$STUB_ROOT/calls.log
printf 'docker %s\n' "$*" >>"$STUB_LOG"
printf 'docker-env PUBLIC_ORIGIN=%s\n' "${PUBLIC_ORIGIN:-}" >>"$STUB_LOG"
[[ -z ${DOC_TOOLS_TAG:-} ]] || printf 'docker-env DOC_TOOLS_TAG=%s DOC_TOOLS_NETWORK=%s\n' "$DOC_TOOLS_TAG" "${DOC_TOOLS_NETWORK:-}" >>"$STUB_LOG"
args=" $* "
NETS=$STUB_ROOT/networks
# The last argument (a network or container name).
last=${*: -1}
case $args in
  " version "*) echo "${STUB_DOCKER_VERSION:-29.1.3}" ;;
  " build "*) exit "${STUB_BUILD_RC:-0}" ;;
  # Networks live in $STUB_ROOT/networks, lines of
  # "<name> <stack label or -> <internal true|false> <attached ids, comma-separated or ->".
  " network ls "*)
    [[ ${STUB_NETWORK_LS_RC:-0} == 0 ]] || exit "$STUB_NETWORK_LS_RC"
    awk '$2 != "-" { print $1 }' "$NETS" 2>/dev/null ;;
  " network inspect "*)
    for a in "$@"; do
      line=$(awk -v n="$a" '$1 == n' "$NETS" 2>/dev/null)
      [[ -n $line ]] && break
    done
    [[ -n $line ]] || exit 1
    read -r _ label internal ids <<<"$line"
    case $args in
      *".Internal"*) echo "$internal $([[ $label == - ]] || echo "$label")" ;;
      *".Containers"*) [[ $ids == - ]] || tr ',' ' ' <<<"$ids" ;;
      *) echo '[]' ;;
    esac
    ;;
  " network create "*)
    [[ ${STUB_NETWORK_CREATE_RC:-0} == 0 ]] || exit "$STUB_NETWORK_CREATE_RC"
    label=- internal=false prev=""
    for a in "$@"; do
      [[ $prev == --label ]] && label=${a#*=}
      [[ $a == --internal ]] && internal=true
      prev=$a
    done
    echo "$last $label $internal -" >>"$NETS"
    ;;
  " network connect "*)
    net=${*: -2:1}
    awk -v n="$net" -v c="$last" '$1 == n { $4 = ($4 == "-" ? c : $4 "," c) } { print }' "$NETS" >"$NETS.tmp" && mv "$NETS.tmp" "$NETS"
    ;;
  " network disconnect "*)
    net=${*: -2:1}
    awk -v n="$net" -v c="$last" '$1 == n { k = split($4, a, ","); o = ""; for (i = 1; i <= k; i++) if (a[i] != c && a[i] != "-") o = o (o ? "," : "") a[i]; $4 = (o ? o : "-") } { print }' "$NETS" >"$NETS.tmp" && mv "$NETS.tmp" "$NETS"
    ;;
  " network rm "*)
    [[ ${STUB_NETWORK_RM_RC:-0} == 0 ]] || exit "$STUB_NETWORK_RM_RC"
    awk -v n="$last" '$1 == n && $4 != "-" { busy = 1 } END { exit busy }' "$NETS" 2>/dev/null || exit 1
    awk -v n="$last" '$1 != n' "$NETS" >"$NETS.tmp" 2>/dev/null && mv "$NETS.tmp" "$NETS"
    ;;
  # The shared project (compose_shared): its config from shared-config.json; its
  # gotenberg exists once `up` ran, as the line "lettuce_shared gotenberg" in
  # containers.txt, with the id gotenberg-id.
  *" -p lettuce_shared "*" config --format json "*) cat "$STUB_ROOT/shared-config.json" 2>/dev/null ;;
  *" -p lettuce_shared "*" up -d "*)
    [[ ${STUB_SHARED_UP_RC:-0} == 0 ]] || exit "$STUB_SHARED_UP_RC"
    grep -qx 'lettuce_shared gotenberg' "$STUB_ROOT/containers.txt" 2>/dev/null ||
      echo 'lettuce_shared gotenberg' >>"$STUB_ROOT/containers.txt"
    ;;
  *" -p lettuce_shared "*" down "*)
    # Like Docker: a removed container leaves every network it was on.
    sed -i '/^lettuce_shared gotenberg$/d' "$STUB_ROOT/containers.txt"
    if [[ -f $NETS ]]; then
      awk '{ k = split($4, a, ","); o = ""; for (i = 1; i <= k; i++) if (a[i] != "gotenberg-id" && a[i] != "-") o = o (o ? "," : "") a[i]; $4 = (o ? o : "-") } { print }' "$NETS" >"$NETS.tmp" && mv "$NETS.tmp" "$NETS"
    fi
    ;;
  *" -p lettuce_shared "*" ps -aq gotenberg "*)
    grep -qx 'lettuce_shared gotenberg' "$STUB_ROOT/containers.txt" 2>/dev/null && echo gotenberg-id
    ;;
  " run "*)
    # Values passed by name (`-e NAME`) go to run-env.log, so tests can tell them
    # from argv, which is all calls.log sees.
    prev="" dst="" out=""
    for a in "$@"; do
      [[ $prev == -e && $a != *=* ]] && printf '%s=%s\n' "$a" "${!a-}" >>"$STUB_ROOT/run-env.log"
      [[ $prev == -c ]] && printf '%s' "$a" >"$STUB_ROOT/run-script"
      [[ $prev == -v && $a == *:/dst ]] && dst=${a%:/dst}
      [[ $a == .partial-* ]] && out=$a
      prev=$a
    done
    [[ ${STUB_RUN_RC:-0} == 0 ]] || exit "$STUB_RUN_RC"
    # STUB_RUN_FAIL: runs whose arguments contain it fail, only the first
    # STUB_RUN_FAIL_TIMES of them when that is set.
    if [[ -n ${STUB_RUN_FAIL:-} && $args == *"$STUB_RUN_FAIL"* ]]; then
      n=$(($(cat "$STUB_ROOT/run-fails" 2>/dev/null || echo 0) + 1))
      echo "$n" >"$STUB_ROOT/run-fails"
      [[ -n ${STUB_RUN_FAIL_TIMES:-} && $n -gt $STUB_RUN_FAIL_TIMES ]] || exit 1
    fi
    # What the container prints, if the test gave it any.
    [[ -f $STUB_ROOT/run-stdout ]] && cat "$STUB_ROOT/run-stdout"
    # Like the backup copy: a snapshot appears in the destination.
    [[ -n $dst && -n $out ]] && mkdir -p "$dst/$out"
    exit 0
    ;;
  " volume inspect "*)
    # STUB_VOLUMES_MISSING: volume names that do not exist, whatever STUB_VOLUME_RC says.
    for v in ${STUB_VOLUMES_MISSING:-}; do
      [[ $args == *" $v "* ]] && exit 1
    done
    exit "${STUB_VOLUME_RC:-0}"
    ;;
  *" pause ") exit "${STUB_PAUSE_RC:-0}" ;;
  *" ps --status running --services "*)
    # Every container in $STUB_ROOT/containers.txt counts as running.
    project=${args#* -p }
    project=${project%% *}
    awk -v p="$project" '$1 == p { print $2 }' "$STUB_ROOT/containers.txt" 2>/dev/null
    ;;
  " image inspect "*)
    [[ ${STUB_IMAGE_RC:-0} == 0 ]] || exit "$STUB_IMAGE_RC"
    # STUB_IMAGES_MISSING: image names (or name prefixes) that do not exist.
    for v in ${STUB_IMAGES_MISSING:-}; do
      [[ $last == "$v"* ]] && exit 1
    done
    # Like a Compose-built image: it carries the project's labels.
    echo '{"Env":["NODE_VERSION=22","PATH=/usr/local/bin:/usr/bin:/bin"],"Labels":{"com.docker.compose.project":"lettuce-alfred","com.docker.compose.service":"app-server","org.opencontainers.image.title":"letta-code"}}'
    ;;
  *" compose version "*) echo "${STUB_COMPOSE_VERSION:-2.40.3}" ;;
  *" ps -a --filter label=com.docker.compose.project="*)
    # Containers come from $STUB_ROOT/containers.txt, lines of "<project> <service>".
    project=${args#* label=com.docker.compose.project=}
    project=${project%% *}
    awk -v p="$project" '$1 == p { print $2 }' "$STUB_ROOT/containers.txt" 2>/dev/null
    ;;
  *" letta agents list "*)
    cat >/dev/null # like `compose exec`, which forwards the caller's stdin
    cat "$STUB_ROOT/agents.json" 2>/dev/null
    exit "${STUB_AGENTS_RC:-0}"
    ;;
  *" exec "*)
    cat >>"$STUB_ROOT/exec-stdin.log"
    # The `sh -c` script goes to exec-script and the arguments after it to
    # exec-args (NUL-separated, $0 included), so tests can run it themselves.
    prev="" script=""
    for a in "$@"; do
      if [[ -n $script ]]; then
        printf '%s\0' "$a" >>"$STUB_ROOT/exec-args"
      elif [[ $prev == -c ]]; then
        printf '%s' "$a" >"$STUB_ROOT/exec-script"
        : >"$STUB_ROOT/exec-args"
        script=1
      fi
      prev=$a
    done
    # What the command prints, if the test gave it anything.
    [[ -f $STUB_ROOT/exec-stdout ]] && cat "$STUB_ROOT/exec-stdout"
    exit "${STUB_EXEC_RC:-0}"
    ;;
  *" config --format json "*)
    # The profiles the rendering used, from its --env-file.
    prev=""
    for a in "$@"; do
      [[ $prev == --env-file ]] && printf 'docker-env-file %s\n' "$(grep '^COMPOSE_PROFILES=' "$a")" >>"$STUB_LOG"
      prev=$a
    done
    cat "$STUB_ROOT/compose-config.json" 2>/dev/null
    ;;
  *" config --services "*)
    # Like upstream: two services always, the rest per COMPOSE_PROFILES in --env-file.
    env_file="" prev=""
    for a in "$@"; do
      [[ $prev == --env-file ]] && env_file=$a
      prev=$a
    done
    printf '%s\n' app-server bff
    IFS=, read -ra ps <<<"$(sed -n 's/^COMPOSE_PROFILES=//p' "$env_file")"
    for p in "${ps[@]}"; do
      case $p in
        search) printf '%s\n' searxng ddg-mcp ;;
        google) echo google-mcp ;;
        telegram) echo channel-gateway ;;
        cloudflared) echo cloudflared ;;
        secrets) echo secret-broker ;;
        gmail-triggers) echo gmail-triggers ;;
        pipelock) echo pipelock ;;
        doc-tools) ;;
      esac
    done
    ;;
  *" config "*) exit "${STUB_COMPOSE_CONFIG_RC:-0}" ;;
esac
exit 0
