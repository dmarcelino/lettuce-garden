#!/usr/bin/env bash
# Test stub for `secret-tool lookup ...`: prints STUB_SECRET_TOOL (in stub.env), or
# fails like a keyring without that entry. Tests copy the stubs to $STUB_ROOT/bin.
STUB_ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=/dev/null
[[ -f $STUB_ROOT/stub.env ]] && . "$STUB_ROOT/stub.env"
[[ ${1:-} == lookup && -n ${STUB_SECRET_TOOL:-} ]] || exit 1
printf '%s\n' "$STUB_SECRET_TOOL"
